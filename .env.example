# Base Mainnet address that receives USDC payments.
PAY_TO=0x0000000000000000000000000000000000000000

# CDP x402 facilitator for Base Mainnet.
FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Base Mainnet in CAIP-2 form.
X402_NETWORK=eip155:8453

# Keep the first real test deliberately tiny.
X402_PRICE_USD=0.001

# Public Base RPC used only to build the paid block snapshot.
BASE_RPC_URL=https://mainnet.base.org

PORT=4021
